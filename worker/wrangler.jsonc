{
  "name": "hml-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "PROFILES", "id": "fa89972330ee40e7a2281e53fcec1271" }],
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "5001", "simple": { "limit": 5, "period": 60 } },
    { "name": "DOWNLOAD_LIMITER", "namespace_id": "5002", "simple": { "limit": 60, "period": 60 } }
  ]
}
