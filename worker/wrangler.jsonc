{
  "name": "hml-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "PROFILES", "id": "<filled at deploy in Task 6>" }],
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "5001", "simple": { "limit": 5, "period": 60 } }
  ]
}
